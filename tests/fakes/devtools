#!/usr/bin/env python3
"""Stand-in for a headless Chromium on its DevTools pipe (``--remote-debugging-pipe``): commands come on fd 3, answers go out on fd 4.

It answers what NonSteamApps' artwork asks of a browser. A card page's icon, or the project's artwork it shows,
loads at 512 pixels, at 32 when the file holds ``tiny``, and fails when it holds ``broken`` or is missing. A
site's page names the icons that $FAKE_DEVTOOLS_SITE_ICONS lists as JSON. A screenshot is the text
``fake <format> <slot> <digest>``, of the artwork shown or else the icon, so that a test can tell what each piece
of artwork was drawn from. Each command is logged, as JSON, in $FAKE_DEVTOOLS_LOG.
"""

import base64
import hashlib
import json
import os
import sys
import urllib.parse

log = os.environ.get("FAKE_DEVTOOLS_LOG")
reader = os.fdopen(3, "rb", buffering=0)
writer = os.fdopen(4, "wb", buffering=0)
pages = {}


def send(message):
    writer.write(json.dumps(message).encode("utf-8") + b"\0")


def icon_of(url):
    query = urllib.parse.parse_qs(urllib.parse.urlsplit(url).query)
    location = urllib.parse.urlsplit((query.get("art") or query.get("icon") or [""])[0])
    try:
        with open(urllib.parse.unquote(location.path), "rb") as stream:
            return query.get("slot", [""])[0], stream.read()
    except OSError:
        return query.get("slot", [""])[0], None


def answer(method, params, session):
    url = pages.get(session, "about:blank")
    if method == "Target.createTarget":
        return {"targetId": "page-1"}
    if method == "Target.attachToTarget":
        return {"sessionId": "session-1"}
    if method == "Browser.getVersion":
        return {"product": "HeadlessChrome/0.0.0.0", "protocolVersion": "1.3"}
    if method == "Page.navigate":
        pages[session] = params["url"]
        return {"frameId": "frame-1"}
    if method == "Runtime.evaluate":
        if "cardReady" in params.get("expression", ""):
            slot, data = icon_of(url)
            ok = data is not None and b"broken" not in data
            size = 32 if data and b"tiny" in data else 512
            return {"result": {"type": "object", "value": {"ok": ok, "width": size, "height": size, "tile": False}}}
        return {"result": {"type": "object", "value": json.loads(os.environ.get("FAKE_DEVTOOLS_SITE_ICONS", "[]"))}}
    if method == "Page.captureScreenshot":
        slot, data = icon_of(url)
        digest = hashlib.sha256(data or b"").hexdigest()[:12]
        return {"data": base64.b64encode(f"fake {params.get('format')} {slot} {digest}".encode("utf-8")).decode("ascii")}
    return {}


buffer = b""
while True:
    chunk = reader.read(1 << 16)
    if not chunk:
        break
    buffer += chunk
    while b"\0" in buffer:
        raw, _, buffer = buffer.partition(b"\0")
        message = json.loads(raw.decode("utf-8"))
        method, params, session = message.get("method", ""), message.get("params") or {}, message.get("sessionId")
        if log:
            with open(log, "a", encoding="utf-8") as handle:
                handle.write(json.dumps({"method": method, "params": params}) + "\n")
        reply = {"id": message["id"], "result": answer(method, params, session)}
        if session:
            reply["sessionId"] = session
        send(reply)
        if method == "Page.navigate":
            send({"method": "Page.loadEventFired", "params": {"timestamp": 0}, "sessionId": session})
        if method == "Browser.close":
            sys.exit(0)
