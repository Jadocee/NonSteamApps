# A SteamOS-like system for NonSteamApps' tests, installed only from one SteamOS release's own repositories, the ones
# a Steam Machine or a Steam Deck updates from, so that the tests run on SteamOS's Python, GnuPG, D-Bus, Xvfb,
# Chromium, flatpak, bubblewrap and KWallet, beside its Dolphin, kdialog and zenity, and Valve's KDE presets, with the
# wallet SteamOS gives every device. It has no Steam, gamescope or Game Mode, and its file system is not read-only.
# An Arch Linux stage installs the packages into an empty root, as pacstrap does, which becomes the image. Opening
# the system Flatpak installation once as root makes it as SteamOS has it, with the Flathub remote that SteamOS's
# flatpak package ships.
# compose.yaml builds and runs it; STEAMOS chooses the release.
FROM archlinux:latest AS bootstrap
ARG STEAMOS=3.8
ARG MIRROR=https://steamdeck-packages.steamos.cloud/archlinux-mirror
RUN set -eu \
    && printf 'Server = %s/$repo/os/$arch\n' "$MIRROR" > /etc/pacman.d/steamos-mirrorlist \
    && sed '/^\[core\]/,$d' /etc/pacman.conf > /etc/steamos-pacman.conf \
    && for repo in jupiter holo core extra multilib; do \
        printf '\n[%s-%s]\nInclude = /etc/pacman.d/mirrorlist\n' "$repo" "$STEAMOS" >> /etc/steamos-pacman.conf; \
    done \
    && sed 's|/etc/pacman.d/mirrorlist|/etc/pacman.d/steamos-mirrorlist|' /etc/steamos-pacman.conf > /tmp/bootstrap.conf \
    && pacman-key --init \
    && pacman-key --populate archlinux \
    && pacman --config /tmp/bootstrap.conf -Sy \
    && curl -fsSL -o /tmp/holo-keyring.pkg.tar.zst "$(pacman --config /tmp/bootstrap.conf -Sp holo-keyring)" \
    && pacman -U --noconfirm /tmp/holo-keyring.pkg.tar.zst \
    && pacman-key --populate holo \
    && mkdir -p /rootfs/var/lib/pacman \
    && pacman --config /tmp/bootstrap.conf --root /rootfs -Sy --noconfirm \
        base bubblewrap chromium dbus dolphin flatpak git gnupg kdialog kwallet diffutils procps-ng python steamdeck-kde-presets xdg-utils xorg-server-xvfb xz zenity \
    && sed -e '/^\[core\]/,$d' -e 's/^\[options\]$/[options]\nDisableSandbox/' /rootfs/etc/pacman.conf > /tmp/steamos.conf \
    && sed -n '/^\[jupiter-/,$p' /etc/steamos-pacman.conf >> /tmp/steamos.conf \
    && cp /tmp/steamos.conf /rootfs/etc/pacman.conf \
    && cp /etc/pacman.d/steamos-mirrorlist /rootfs/etc/pacman.d/mirrorlist \
    && rm -rf /rootfs/etc/pacman.d/gnupg /var/cache/pacman/pkg/* \
    && cp -a /etc/pacman.d/gnupg /rootfs/etc/pacman.d/gnupg

FROM scratch
ARG STEAMOS=3.8
COPY --from=bootstrap /rootfs/ /
ENV LANG=C.UTF-8 PYTHONDONTWRITEBYTECODE=1 STEAMOS_RELEASE=$STEAMOS
RUN ldconfig \
    && systemd-tmpfiles --create /usr/lib/tmpfiles.d/etc.conf \
    && update-ca-trust \
    && systemd-sysusers \
    && systemd-machine-id-setup \
    && flatpak remote-list --system >/dev/null \
    && useradd --create-home --uid 1000 deck
USER deck
